# ================= LLM =================
# Fallback global se o workspace nao tiver chave propria
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini

# ============== Evolution API (WhatsApp) ==============
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=forceia-dev-key
EVOLUTION_INSTANCE=forceia

# ================= Supabase =================
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ================= Multi-tenant =================
DEFAULT_WORKSPACE_SLUG=default

# ============== Webhook (seguranca) ==============
# Porta do webhook (default 8000)
PORT=8000
# Se true, mensagens sem instance/api-key caem no DEFAULT_WORKSPACE_SLUG.
# Em producao multi-cliente, prefira false para evitar rota errada.
WEBHOOK_ALLOW_DEFAULT_FALLBACK=true
# Se definido, o webhook exige o header X-Webhook-Token igual a este valor.
WEBHOOK_SHARED_TOKEN=

# ============== Painel Admin ==============
# Obrigatorio para ligar o painel. Gere um valor forte (ex: openssl rand -hex 24)
ADMIN_TOKEN=
ADMIN_PORT=8100

# ================= Follow-up (fallback) =================
FOLLOWUP_STALE_DAYS=5
FOLLOWUP_MIN_HOURS=48

# ================= Twenty CRM (fallback) =================
TWENTY_API_URL=
TWENTY_API_KEY=
TWENTY_CREATE_OPP_ALWAYS=true
TWENTY_STAGE_SDR=NEW
TWENTY_STAGE_QUALIFIED=SCREENING
TWENTY_STAGE_CLOSER=MEETING
TWENTY_STAGE_FOLLOWUP=SCREENING
TWENTY_STAGE_WON=CUSTOMER
TWENTY_STAGE_LOST=REJECTED

# ================= Observabilidade =================
ENVIRONMENT=development
LOG_LEVEL=info
# text (default) ou json (recomendado em producao)
LOG_FORMAT=text

# ================= LangGraph =================
# 1 = usa grafo (padrao se langgraph instalado); 0 = fluxo linear legado
FORCEIA_USE_GRAPH=1
# Opcional: path SQLite para checkpoints persistentes entre processos
# FORCEIA_GRAPH_SQLITE=/var/lib/forceia/graph_checkpoints.db
