# ForceIA — variáveis de ambiente (exemplo)
# Copie para .env e preencha.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Twenty CRM
TWENTY_API_URL=
TWENTY_API_KEY=

# Webhook
WEBHOOK_SHARED_TOKEN=

# --- Auth admin (JWT) ---
# Preferir JWT em produção. ADMIN_TOKEN permanece como fallback legado.
ADMIN_USER=admin
ADMIN_PASSWORD=Admin!ForceIA2026x
# Política: min 12 chars, maiúscula, minúscula, dígito, símbolo
# FORCEIA_ALLOW_WEAK_PASSWORD=1  # só em dev local
JWT_SECRET=gere-um-segredo-longo-aleatorio
JWT_EXPIRE_MINUTES=480
# Legado (opcional): token estático ainda aceito
ADMIN_TOKEN=
ADMIN_PORT=8100

# LangGraph
FORCEIA_USE_GRAPH=1

# Langfuse (observabilidade)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=1
